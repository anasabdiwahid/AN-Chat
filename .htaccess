# Apache configuration for A/N Chat
Options -Indexes

# UTF-8 Charset
AddDefaultCharset UTF-8

# Block direct access to database SQL file and hidden files
<FilesMatch "\.(sql|log|md|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable Gzip compression if module available
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

